# Managed by Inside-VM Egress Guard.
# Local rules provide a stable BitTorrent floor even when upstream feeds change.

drop tcp $HOME_NET any -> $EXTERNAL_NET any (msg:"ANTI-ABUSE P2P BitTorrent protocol handshake"; flow:established,to_server; content:"BitTorrent protocol"; depth:19; classtype:policy-violation; sid:9900001; rev:1; metadata:attack_target client, deployment inside_vm_egress_guard, service bittorrent;)
drop udp $HOME_NET any -> $EXTERNAL_NET any (msg:"ANTI-ABUSE P2P BitTorrent DHT get_peers"; content:"d1:"; depth:3; content:"1:q9:get_peers"; distance:0; within:64; classtype:policy-violation; sid:9900002; rev:1; metadata:attack_target client, deployment inside_vm_egress_guard, service bittorrent;)
drop udp $HOME_NET any -> $EXTERNAL_NET any (msg:"ANTI-ABUSE P2P BitTorrent DHT find_node"; content:"d1:"; depth:3; content:"1:q9:find_node"; distance:0; within:64; classtype:policy-violation; sid:9900003; rev:1; metadata:attack_target client, deployment inside_vm_egress_guard, service bittorrent;)
drop udp $HOME_NET any -> $EXTERNAL_NET any (msg:"ANTI-ABUSE P2P BitTorrent DHT announce_peer"; content:"d1:"; depth:3; content:"1:q13:announce_peer"; distance:0; within:80; classtype:policy-violation; sid:9900004; rev:1; metadata:attack_target client, deployment inside_vm_egress_guard, service bittorrent;)
drop http $HOME_NET any -> $EXTERNAL_NET any (msg:"ANTI-ABUSE P2P BitTorrent tracker announce"; flow:established,to_server; http.uri; content:"/announce"; nocase; content:"info_hash="; nocase; classtype:policy-violation; sid:9900005; rev:1; metadata:attack_target client, deployment inside_vm_egress_guard, service bittorrent;)
drop http $HOME_NET any -> $EXTERNAL_NET any (msg:"ANTI-ABUSE P2P BitTorrent tracker scrape"; flow:established,to_server; http.uri; content:"/scrape"; nocase; content:"info_hash="; nocase; classtype:policy-violation; sid:9900006; rev:1; metadata:attack_target client, deployment inside_vm_egress_guard, service bittorrent;)
